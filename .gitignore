# Build output — regenerated by `npm run build`, never edited by hand.
dist/

# Node
node_modules/
npm-debug.log*
.npm/

# Original photos.
#
# src/assets/img/source/ holds the full-size originals you drop in. They are
# deliberately NOT committed: phone photos run 3–8 MB each, they would bloat
# the repository permanently, and only the processed derivatives in
# src/assets/img/ are ever served.
#
# Keep your originals in your own backup (Google Drive, an external disk).
# Losing them only means you cannot regenerate at a different size later.
src/assets/img/source/*
!src/assets/img/source/README.txt

# Source footage for the hero video, same reasoning — video files are large.
src/assets/video/*.source.*

# Intermediate files from the media pipeline
src/assets/img/.master-*
public/.ico-*

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.tmp-*

# Local environment
.env
.env.local
.vercel

# Local screenshots for review — not part of the site.
.preview/
